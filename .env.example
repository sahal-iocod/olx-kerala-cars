TELEGRAM_BOT_TOKEN=your_bot_token_here
TELEGRAM_CHAT_ID=your_chat_id_here

# Run browsers invisibly (needed for VPS / 24-7 use).
# Set to false if OLX starts blocking headless sessions.
HEADLESS=true

# How often to check OLX, in minutes.
# Every 5 minutes is aggressive for a single visitor watching one
# search, and it is a large part of why the edge starts blocking.
# 15-20 reads like a person checking for new cars.
CHECK_INTERVAL_MINUTES=15

# How many listings to look at per check.
MAX_LISTINGS_TO_CHECK=25

# Seen ads older than this many days are pruned from seen_ads.json.
SEEN_ADS_MAX_AGE_DAYS=60

# ---- Web app / server settings ----
# Interface and port the filter web app listens on.
# Keep 127.0.0.1 on a VPS and expose it through nginx (see deploy/).
WEBAPP_HOST=127.0.0.1
WEBAPP_PORT=5001

# Start the notifier automatically when the web app starts
# (so it comes back after a reboot without pressing "Start Bot").
BOT_AUTOSTART=true

# Never enable on a public server.
FLASK_DEBUG=false

# Optional residential/mobile proxy for the scraper's Chrome.
# OLX's edge blocks datacenter IPs, so a VPS often needs one.
# Leave empty to connect directly.
PROXY_SERVER=
PROXY_USERNAME=
PROXY_PASSWORD=
